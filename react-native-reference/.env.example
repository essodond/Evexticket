# API Django appelee par l'application mobile.
# Ne jamais mettre les identifiants QosPay dans l'app mobile.
EXPO_PUBLIC_API_BASE_URL=https://api.evex-tg.com/api

# Mode test actuel : false permet de réserver sans appeler QOS/Flooz/TMoney.
# Remettre true pour réactiver le parcours de paiement mobile réel.
EXPO_PUBLIC_MOBILE_PAYMENTS_ENABLED=false

# Moteur d'itinéraires routiers. Le serveur OSRM public convient au développement.
# En production, pointer cette variable vers une instance OSRM dédiée ou un fournisseur avec SLA.
EXPO_PUBLIC_ROUTING_API_URL=https://router.project-osrm.org

# Nécessaire pour afficher react-native-maps dans un APK/AAB Android autonome.
# Restreindre cette clé dans Google Cloud au package com.evex.ticket + certificat SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=
